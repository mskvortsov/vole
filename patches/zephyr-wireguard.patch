+/*
+ * wg_resolve_msg_type - map a raw 4-byte type value to a canonical MESSAGE_x.
+ *
+ * In standard mode the type must exactly equal one of the four defined values.
+ * In AmneziaWG mode each message type is represented by a configured range
+ * [min, max]; the raw value is accepted if it falls within that range.
+ *
+ * Returns MESSAGE_INVALID (0) if the value matches no known type.
+ */
+static int wg_resolve_msg_type(const struct wg_peer *peer, uint32_t raw_type)
+{
+	if (!peer->awg.enabled) {
+		/* Standard mode: upper 3 bytes must be zero (reserved), low
+		 * byte carries the type (1-4).
+		 */
+		if (raw_type == MESSAGE_HANDSHAKE_INITIATION ||
+		    raw_type == MESSAGE_HANDSHAKE_RESPONSE   ||
+		    raw_type == MESSAGE_COOKIE_REPLY         ||
+		    raw_type == MESSAGE_TRANSPORT_DATA) {
+			return (int)raw_type;
+		}
+		return MESSAGE_INVALID;
+	}
+
+	/* AmneziaWG mode: check each range in order. */
+	for (int i = 0; i < 4; i++) {
+		if (raw_type >= peer->awg.header[i].min &&
+		    raw_type <= peer->awg.header[i].max) {
+			return i + 1; /* MESSAGE_x = index + 1 */
+		}
+	}
+	return MESSAGE_INVALID;
+}
