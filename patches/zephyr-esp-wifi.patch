+#define AQL_TARGET_CYC  k_ms_to_cyc_ceil32(10)
+#define AQL_MIN_BYTES   1500U
+#define AQL_MAX_BYTES   (16U * 1500U)
+#define AQL_INIT_BYTES  (4U * 1500U)
+
+extern void esp_wifi_rx_cb(struct net_pkt *pkt);
+extern void esp_wifi_tx_cb(struct net_pkt *pkt);
