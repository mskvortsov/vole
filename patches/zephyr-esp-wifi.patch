+			       uint32_t aql_limit);
+
+static struct k_spinlock tx_inflight_lock;
+static atomic_ptr_t last_post_hmac_tx_ebuf = ATOMIC_PTR_INIT(NULL);
+
+static void esp32_reset_tx_inflight(struct esp32_wifi_runtime *rt)
+{
+	K_SPINLOCK(&tx_inflight_lock) {
+		rt->tx_inflight_total = 0;
+		rt->tx_inflight_bitmap = 0;
+	}
+	rt->tx_aql_limit = AQL_INIT_BYTES;
+	rt->tx_sojourn_ewma_cyc = 0;
+}
+
+/* Wrapper over real ieee80211_post_hmac_tx defined in blob */
+int ieee80211_post_hmac_tx(struct esp_wifi_ebuf *ebuf)
+{
+	extern int __real_ieee80211_post_hmac_tx(struct esp_wifi_ebuf *ebuf);
+	atomic_ptr_set(&last_post_hmac_tx_ebuf, ebuf);
+	return __real_ieee80211_post_hmac_tx(ebuf);
+}
+
+static int esp32_wifi_internal_tx_inflight(struct esp32_wifi_runtime *rt, void *frame, size_t len)
+{
+	wifi_interface_t ifx = rt == &esp32_data ? WIFI_IF_STA : WIFI_IF_AP;
+	const struct esp_wifi_ebuf *ebuf;
+	size_t index;
+	int ret;
+
+	index = find_lsb_set(~rt->tx_inflight_bitmap);
+	if (index == 0) {
+		return ESP_ERR_NO_MEM;
+	}
+	index -= 1;
+
+	atomic_ptr_clear(&last_post_hmac_tx_ebuf);
+	ret = esp_wifi_internal_tx(ifx, frame, len);
+	if (ret != ESP_OK) {
+		return ret;
+	}
+
+	ebuf = atomic_ptr_clear(&last_post_hmac_tx_ebuf);
+	if (!ebuf) {
+		LOG_WRN("ieee80211_post_hmac_tx didn't set ebuf pointer");
+		return ret;
+	}
+
+	K_SPINLOCK(&tx_inflight_lock) {
+		struct tx_entry *entry = &rt->tx_inflight[index];
+		entry->ebuf = ebuf;
+		entry->len = len;
+		entry->timestamp_cyc = k_cycle_get_32();
+		rt->tx_inflight_bitmap |= 1U << index;
+		rt->tx_inflight_total += len;
+	}
+
+	return ret;
+}
+
+static struct tx_entry *esp32_remove_tx_inflight_entry(struct esp32_wifi_runtime *rt,
+						       struct esp_wifi_ebuf *ebuf)
+{
+	uint32_t bitmap = rt->tx_inflight_bitmap;
+	size_t index;
+
+	while ((index = find_lsb_set(bitmap)) != 0) {
+		index -= 1;
+		bitmap &= ~(1U << index);
+		if (rt->tx_inflight[index].ebuf == ebuf) {
+			rt->tx_inflight_bitmap &= ~(1U << index);
+			return &rt->tx_inflight[index];
+		}
+	}
+
+	return NULL;
+}
+
+static void esp32_tx_done(uint8_t ifx, uint8_t *data, uint16_t *data_len, bool tx_status)
+{
+	struct esp_wifi_ebuf *ebuf = CONTAINER_OF(data_len, struct esp_wifi_ebuf, len);
+	struct esp32_wifi_runtime *rt;
+	struct tx_entry *entry;
+	uint32_t now = k_cycle_get_32();
+
+	if (!data_len) {
+		LOG_WRN("data_len ptr is NULL");
+		return;
+	}
+
+	K_SPINLOCK(&tx_inflight_lock) {
+		entry = esp32_remove_tx_inflight_entry(&esp32_data, ebuf);
+		if (entry) {
+			rt = &esp32_data;
+		} else {
+			entry = esp32_remove_tx_inflight_entry(&esp32_ap_sta_data, ebuf);
+			if (entry) {
+				rt = &esp32_ap_sta_data;
+			}
+		}
+	}
+
+	if (entry) {
+		rt->tx_inflight_total -= entry->len;
+	} else {
+		/* ifx 255 is presumably broadcast traffic */
+		if (ifx != 255) {
+			LOG_WRN("cannot find tx inflight entry, ifx %d len %u tx_status %d", ifx,
+				*data_len, tx_status);
+		}
+		return;
+	}
+
+	uint32_t sojourn = now - entry->timestamp_cyc;
+
+	rt->tx_sojourn_ewma_cyc = rt->tx_sojourn_ewma_cyc
+				  - (rt->tx_sojourn_ewma_cyc >> 2)
+				  + (sojourn >> 2);
+
+	if (rt->tx_sojourn_ewma_cyc > AQL_TARGET_CYC) {
+		rt->tx_aql_limit = MAX(rt->tx_aql_limit - entry->len, AQL_MIN_BYTES);
+	} else {
+		rt->tx_aql_limit = MIN(rt->tx_aql_limit + AQL_MIN_BYTES, AQL_MAX_BYTES);
+	}
+
+	wifi_interface_t tx_ifx = (rt == &esp32_data) ? WIFI_IF_STA : WIFI_IF_AP;
+	esp_wifi_tx_aql_cb(tx_ifx, k_cyc_to_ns_floor32(rt->tx_sojourn_ewma_cyc),
+			   rt->tx_inflight_total, rt->tx_aql_limit);
+
+	const char *tx_status_str = tx_status ? "succ" : "fail";
+	if (ifx == WIFI_IF_STA) {
+		LOG_INF("sta %6u us, aql %6u, len %4u %s",
+			k_cyc_to_us_floor32(sojourn), rt->tx_aql_limit, *data_len, tx_status_str);
+	} else if (ifx == WIFI_IF_AP) {
+		LOG_INF("                                              "
+			" ap %6u us, aql %6u, len %4u %s",
+			k_cyc_to_us_floor32(sojourn), rt->tx_aql_limit, *data_len, tx_status_str);
+	} else if (ifx == 255) {
+		LOG_INF("                       "
+			"255 %6u us, aql %6u, len %4u %s",
+			k_cyc_to_us_floor32(sojourn), rt->tx_aql_limit, *data_len, tx_status_str);
+	} else {
+		LOG_ERR("unexpected ifx %d", ifx);
+	}
+
+	LOG_INF_RATELIMIT("inflight bitmap sta %032b", esp32_data.tx_inflight_bitmap);
+	LOG_INF_RATELIMIT("inflight bitmap  ap %032b", esp32_ap_sta_data.tx_inflight_bitmap);
+}
