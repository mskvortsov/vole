diff --git a/subsys/net/lib/wireguard/wg_crypto.c b/subsys/net/lib/wireguard/wg_crypto.c
--- a/subsys/net/lib/wireguard/wg_crypto.c
+++ b/subsys/net/lib/wireguard/wg_crypto.c
@@ -839,9 +839,18 @@ static bool wg_create_handshake_init(struct wg_iface_context *ctx,
 	/* Hi := Hash(Ci || Identifier) */
 	memcpy(handshake->hash, ctx->wg_ctx->identifier_hash, WG_HASH_LEN);
 
 	/* Hi := Hash(Hi || Spubr) */
 	wg_mix_hash(handshake->hash, peer->key.public_key, WG_PUBLIC_KEY_LEN);
 
+	/* Free any leftover ephemeral key from a previous unanswered init.
+	 * Without this, each retry leaks a PSA key slot; once the pool is
+	 * exhausted, future handshakes fail permanently until reboot.
+	 */
+	if (handshake->ephemeral_private_id != PSA_KEY_ID_NULL) {
+		wg_psa_destroy_key(handshake->ephemeral_private_id);
+		handshake->ephemeral_private_id = PSA_KEY_ID_NULL;
+	}
+
 	/* (Eprivi, Epubi) := DH-Generate() */
 	psa_ret = wg_psa_generate_x25519_keypair(&handshake->ephemeral_private_id,
 						 msg_ephemeral);
